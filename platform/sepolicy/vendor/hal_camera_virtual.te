# Virtual camera HAL — vendor APEX packaging (the shipping architecture).
#
# The HAL binary is labeled hal_camera_default_exec by the APEX file_contexts,
# so it runs in hal_camera_default: the standard vendor camera-HAL domain that
# already carries gralloc/GPU/binder access and may register
# hal_camera_service names (ICameraProvider/virtual_renderer/0 is one, see
# service_contexts next to this file).
#
# The second interface the HAL exposes — the frozen
# android.hardware.virtualcamera.hal boundary — is modelled as the HAL
# attribute hal_virtualcamera (declared in system_ext public policy,
# platform/sepolicy/system_ext_public/). This file binds the server side.

# Service name label for IVirtualCameraHal/default. vendor_service: only a
# vendor domain may add it (Treble neverallow). protected_service: untrusted
# apps may not even find it.
type hal_virtualcamera_service, vendor_service, protected_service, hal_service_type, service_manager_type;

# add for servers, find for clients, plus the neverallows that keep it that way.
hal_attribute_service(hal_virtualcamera, hal_virtualcamera_service)

# This process serves the boundary (in addition to being the camera HAL).
hal_server_domain(hal_camera_default, hal_virtualcamera)

# GpuCompositor: EGL/GLES initialization inside the HAL queries
# ISurfaceFlingerConfigs through the configstore HAL.
hal_client_domain(hal_camera_default, hal_configstore)
