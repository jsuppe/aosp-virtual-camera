/*
 * Virtual Camera Core - A13 PLATFORM build (system_ext, AIDL relay mode)
 * Installed by integrate-a13-platform.sh over core/Android.bp.
 */

package {
    default_applicable_licenses: ["hardware_interfaces_license"],
}

cc_library_static {
    name: "virtual-camera-core",
    system_ext_specific: true,

    srcs: [
        "VirtualCameraFrameSource.cpp",
        "VirtualCameraFrameSourceV2.cpp",
        "VirtualCameraSocket.cpp",
        "FrameFiller.cpp",
        "MetadataBuilder.cpp",
        "VendorTags.cpp",
        "AidlFrameSource.cpp",
        "AvailabilityBridge.cpp",
    ],

    shared_libs: [
        "android.hardware.graphics.mapper@2.0",
        "android.hardware.graphics.mapper@3.0",
        "android.hardware.graphics.mapper@4.0",
        "android.hidl.allocator@1.0",
        "android.hidl.memory@1.0",
        "libbinder",
        "libcamera_metadata",
        "libcutils",
        "libgralloctypes",
        "libgui",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libui",
        "libutils",
        "libbase",
        "libnativewindow",
        "libsync",
        "libvirtualcamera_platform_aidl",
    ],

    static_libs: [
        "android.hardware.camera.common@1.0-helper",
    ],

    include_dirs: [
        "hardware/interfaces/camera/common/1.0/default/include",
        "hardware/interfaces/camera/provider/v2-shared-memory",
    ],

    local_include_dirs: ["."],
    export_include_dirs: ["."],

    cflags: [
        "-Wall", "-DVCAM_COMPAT_A13=1", "-DVCAM_AIDL_SOURCE=1",
        "-Wno-unused-parameter",
    ],
}
