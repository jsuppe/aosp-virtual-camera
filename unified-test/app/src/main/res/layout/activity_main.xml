<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Virtual Media Test"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="4dp"
        android:background="#16213e"/>

    <!-- Side-by-side video views - Fixed height -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:orientation="horizontal"
        android:padding="4dp">

        <!-- Left: Direct render (what we send) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📤 Sending"
                android:textColor="#4CAF50"
                android:textSize="11sp"
                android:gravity="center"/>

            <SurfaceView
                android:id="@+id/renderer_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>

        <!-- Right: Camera preview (what apps see) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📥 Camera Output"
                android:textColor="#2196F3"
                android:textSize="11sp"
                android:gravity="center"/>

            <TextureView
                android:id="@+id/camera_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Latency Stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:gravity="center">

        <TextView
            android:id="@+id/video_latency_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎬 Video: --ms"
            android:textColor="#2196F3"
            android:textSize="12sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/audio_latency_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎤 Audio: --ms"
            android:textColor="#4CAF50"
            android:textSize="12sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/av_sync_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⏱️ Sync: --"
            android:textColor="#888888"
            android:textSize="12sp"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Latency Graph - takes remaining space -->
    <com.example.vcamtest.LatencyGraphView
        android:id="@+id/latency_graph"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="4dp"
        android:layout_marginVertical="2dp"/>

    <!-- Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4dp"
        android:background="#16213e">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/start_button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="▶ Video"
                android:textSize="14sp"
                android:enabled="false"/>

            <Button
                android:id="@+id/audio_button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="▶ Audio"
                android:textSize="14sp"
                android:layout_marginStart="4dp"
                android:enabled="false"/>
        </LinearLayout>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connecting..."
            android:textColor="#888888"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingTop="2dp"/>
    </LinearLayout>

</LinearLayout>
